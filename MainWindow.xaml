<Window x:Class="Prism.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Prism"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Prism Crosshair" Width="1264" Height="806" MinWidth="1010" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Icon="/Assets/Prism.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" KeyDown="WindowKeyDown" PreviewKeyDown="WorkspaceKeyDown" LostMouseCapture="HistoryCaptureLost" Loaded="WorkspaceLoaded">
  <chrome:WindowChrome.WindowChrome>
    <chrome:WindowChrome CaptionHeight="51" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </chrome:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="25,0,12,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <TextBlock Text="Prism" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="Bold"/>
          <Image Source="/Assets/Prism.ico" Width="23" Height="23" Margin="10,0,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="MinimizeClick" ToolTip="Свернуть" AutomationProperties.Name="Свернуть"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="MaximizeClick" ToolTip="Развернуть" AutomationProperties.Name="Развернуть"/>
          <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="CloseClick" ToolTip="Закрыть Prism" AutomationProperties.Name="Закрыть Prism"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,18">
          <Button x:Name="EditorTab" Tag="active" Click="EditorClick" Style="{StaticResource NavButton}" AutomationProperties.Name="Редактор">
            <StackPanel><TextBlock Text="&#xE771;" Style="{StaticResource RailGlyph}"/><TextBlock Text="Редактор" Style="{StaticResource RailLabel}"/></StackPanel>
          </Button>
          <Button x:Name="ProfilesTab" Click="ProfilesClick" Style="{StaticResource NavButton}" AutomationProperties.Name="Профили">
            <StackPanel><TextBlock Text="&#xE8F1;" Style="{StaticResource RailGlyph}"/><TextBlock Text="Профили" Style="{StaticResource RailLabel}"/></StackPanel>
          </Button>
          <Button x:Name="SettingsTab" Click="SettingsClick" Style="{StaticResource NavButton}" AutomationProperties.Name="Настройки">
            <StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource RailGlyph}"/><TextBlock Text="Настройки" Style="{StaticResource RailLabel}"/></StackPanel>
          </Button>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="23,16,23,0">
      <Grid x:Name="EditorPanel">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Прицел" Style="{StaticResource PageHeading}"/>
            <TextBlock x:Name="ProfileCaption" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="2,0,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7"
                    Padding="11,0" Height="36" Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="HeaderShortcut" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" FontSize="12"/>
            </Border>
            <Button x:Name="OverlayButton" Tag="primary" Click="OverlayClick" MinHeight="39" Padding="16,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="OverlayButtonLabel" VerticalAlignment="Center" FontSize="14"/>
                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/><ColumnDefinition Width="345"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Padding="0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition/><RowDefinition Height="51"/><RowDefinition Height="64"/></Grid.RowDefinitions>
              <DockPanel Margin="14,0">
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,7" Style="{StaticResource StageChip}">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="OverlayIndicator" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="FooterOverlayStatus" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Предпросмотр" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,13,0"/>
                  <Button x:Name="UndoButton" IsEnabled="False" Content="&#xE7A7;" Style="{StaticResource IconButton}" Click="UndoClick"
                          AutomationProperties.Name="Отменить изменение" ToolTip="Отменить изменение · Ctrl + Z" Width="32" Margin="0,0,4,0"/>
                  <Button x:Name="RedoButton" IsEnabled="False" Content="&#xE7A6;" Style="{StaticResource IconButton}" Click="RedoClick"
                          AutomationProperties.Name="Повторить изменение" ToolTip="Повторить изменение · Ctrl + Y" Width="32"/>
                </StackPanel>
              </DockPanel>
              <local:PreviewSurface Grid.Row="1" x:Name="Preview" ClipToBounds="True" IsHitTestVisible="False"/>
              <DockPanel Grid.Row="2" Margin="14,0" LastChildFill="False">
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource StageChip}">
              <StackPanel Orientation="Horizontal" Margin="2">
                <Button x:Name="ZoomOut" Content="−" Width="27" MinHeight="27" Padding="0" BorderThickness="0" Background="Transparent"
                        Click="ZoomOutClick" AutomationProperties.Name="Уменьшить масштаб"/>
                <Button x:Name="ActualSizeButton" Width="38" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="27" Click="ActualSizeClick"
                        AutomationProperties.Name="Показать в реальном размере" ToolTip="Показать в реальном размере · 1:1">
                  <TextBlock x:Name="ZoomLabel" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14"/>
                </Button>
                <Button x:Name="ZoomIn" Content="+" Width="27" MinHeight="27" Padding="0" BorderThickness="0" Background="Transparent"
                        Click="ZoomInClick" AutomationProperties.Name="Увеличить масштаб"/>
              </StackPanel>
            </Border>
                <TextBlock DockPanel.Dock="Left" Text="Фон" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <ComboBox x:Name="SceneBox" DockPanel.Dock="Left" VerticalAlignment="Center" Width="142" MinHeight="32" Margin="8,0,0,0"
                      Background="{StaticResource PanelBrush}" SelectionChanged="PreviewChanged" AutomationProperties.Name="Фон предпросмотра"/>
                              <Button x:Name="GuideButton" DockPanel.Dock="Left" Content="Разметка" Tag="selected" Click="GuidesClick" ToolTip="Показать или скрыть сетку и линейки" VerticalAlignment="Center" MinHeight="32" Margin="7,0,0,0"/>
                <Button x:Name="CompareButton" DockPanel.Dock="Left" Content="До / Сейчас" IsEnabled="False" Click="CompareClick" ToolTip="Сравнить с предыдущим состоянием" VerticalAlignment="Center" MinHeight="32" Margin="6,0,0,0"/>
              </DockPanel>
              <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="13,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72A;" Width="32" VerticalAlignment="Center"
                          Click="NextTipClick" AutomationProperties.Name="Следующая подсказка" ToolTip="Следующая подсказка"/>
                  <Button DockPanel.Dock="Left" Width="47" Height="44" BorderThickness="0" Background="Transparent" Padding="0"
                          VerticalAlignment="Center" Click="PetGuideClick" AutomationProperties.Name="Погладить Пикселя" ToolTip="Погладить Пикселя" Margin="0,0,9,0">
                    <local:PixelGuide x:Name="Pixel" Width="41" Height="39"/>
                  </Button>
                  <Button x:Name="TryCatButton" DockPanel.Dock="Right" MinHeight="29" Content="Примерить «Котика»" Click="TryCatClick"
                          Visibility="Collapsed" Margin="4,0,5,0" VerticalAlignment="Center"/>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
                    <TextBlock Text="Пиксель" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="TipText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,3,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,13">
                <TextBlock Text="Параметры прицела" Style="{StaticResource SectionHeading}"/>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="7,6">
          <Button x:Name="ShapeTool" Style="{StaticResource ToolButton}" Click="TuningClick" AutomationProperties.Name="Форма">
            <DockPanel>
              <Border Style="{StaticResource ToolIcon}"><Path Data="M0,5 L10,5 M5,0 L5,10" Stroke="{StaticResource TextBrush}"
                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel><TextBlock Text="Форма"/><TextBlock x:Name="ShapeValue" Style="{StaticResource ToolValue}"/></StackPanel>
            </DockPanel>
          </Button>
          <Border x:Name="ShapeDetails" Style="{StaticResource InspectorDetail}">
        <StackPanel>
          <TextBlock Text="Вид метки" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
          <UniformGrid x:Name="ShapeButtons" Columns="4" Margin="-3,0,-3,0"/>
          <CheckBox x:Name="DotToggle" Content="Центральная точка" Checked="DotChanged" Unchecked="DotChanged" Margin="0,6,0,0"/>
            <CheckBox x:Name="SquareToggle" Content="Квадратная точка" Checked="DetailChanged" Unchecked="DetailChanged"/>
            <CheckBox x:Name="RoundToggle" Content="Скруглить концы лучей" Checked="DetailChanged" Unchecked="DetailChanged"/>
            <StackPanel x:Name="AngleSliders" Margin="-7,3,-7,0"/>
        </StackPanel>
          </Border>
          <Button x:Name="SizeTool" Style="{StaticResource ToolButton}" Click="TuningClick" AutomationProperties.Name="Размер">
            <DockPanel>
              <Border Style="{StaticResource ToolIcon}"><Path Data="M4,0 L0,4 4,8 M0,4 L13,4 M9,0 L13,4 9,8" Stroke="{StaticResource TextBrush}"
                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <StackPanel><TextBlock Text="Размер"/><TextBlock x:Name="SizeValue" Style="{StaticResource ToolValue}"/></StackPanel>
            </DockPanel>
          </Button>
          <Border x:Name="SizeDetails" Style="{StaticResource InspectorDetail}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Сбросить" Click="ResetClick" MinHeight="26"
                    Padding="7,0" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Геометрия" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel x:Name="GeometrySliders" Margin="-7,0"/>
            <CheckBox x:Name="VerticalToggle" Content="Своя длина вертикальных лучей" Checked="DetailChanged" Unchecked="DetailChanged"/>
            <StackPanel x:Name="VerticalSliders" Margin="-7,0"/>
        </StackPanel>
          </Border>
          <Button x:Name="ColorTool" Style="{StaticResource ToolButton}" Click="TuningClick" AutomationProperties.Name="Цвет">
            <DockPanel>
              <Border Style="{StaticResource ToolIcon}"><Ellipse x:Name="ColorValueSwatch" Width="11" Height="11" VerticalAlignment="Center"/></Border>
              <StackPanel><TextBlock Text="Цвет"/><TextBlock x:Name="ColorValue" Style="{StaticResource ToolValue}" FontFamily="Consolas"/></StackPanel>
            </DockPanel>
          </Button>
          <Border x:Name="ColorDetails" Style="{StaticResource InspectorDetail}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <TextBox x:Name="HexInput" DockPanel.Dock="Right" Width="89" MinHeight="29" MaxLength="7" VerticalAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12" KeyDown="HexKeyDown" LostKeyboardFocus="HexLostFocus"
                     ToolTip="Введите HEX-цвет и нажмите Enter" AutomationProperties.Name="HEX-цвет"/>
            <TextBlock Text="Палитра" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
          </DockPanel>
          <UniformGrid x:Name="Palette" Rows="1" Margin="-2,0"/>
          <StackPanel x:Name="ColorControls" Margin="-7,8,-7,0"/>
        </StackPanel>
          </Border>
          <Button x:Name="OutlineTool" Style="{StaticResource ToolButton}" Click="TuningClick" AutomationProperties.Name="Контур">
            <DockPanel>
              <Border Style="{StaticResource ToolIcon}"><Ellipse Width="11" Height="11" Stroke="{StaticResource TextBrush}"
                      StrokeThickness="1.7" VerticalAlignment="Center"/></Border>
              <StackPanel><TextBlock Text="Контур"/><TextBlock x:Name="OutlineValue" Style="{StaticResource ToolValue}"/></StackPanel>
            </DockPanel>
          </Button>
          <Border x:Name="OutlineDetails" Style="{StaticResource InspectorDetail}">
        <StackPanel>
          <TextBlock Text="Обводка" Style="{StaticResource Caption}"/>
          <CheckBox x:Name="OutlineToggle" Content="Показывать контур" Checked="OutlineChanged" Unchecked="OutlineChanged" Margin="0,4,0,0"/>
          <StackPanel x:Name="OutlineSliders" Margin="-7,0"/>
            <TextBlock Text="Цвет контура" Style="{StaticResource Caption}" Margin="0,6,0,5"/>
            <UniformGrid x:Name="OutlinePalette" Rows="1"/>
        </StackPanel>
          </Border>
          <Button x:Name="PositionTool" Style="{StaticResource ToolButton}" Click="TuningClick" AutomationProperties.Name="Положение">
            <DockPanel>
              <Border Style="{StaticResource ToolIcon}">
                <Grid><Ellipse Width="12" Height="12" Stroke="{StaticResource TextBrush}" StrokeThickness="1.2"/>
                  <Ellipse Width="4" Height="4" Fill="{StaticResource TextBrush}"/></Grid>
              </Border>
              <StackPanel><TextBlock Text="Положение"/><TextBlock x:Name="PositionValue" Style="{StaticResource ToolValue}"/></StackPanel>
            </DockPanel>
          </Button>
          <Border x:Name="PositionDetails" Style="{StaticResource InspectorDetail}">
        <StackPanel>
          <TextBlock Text="Смещение от центра" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
          <StackPanel x:Name="OffsetSliders" Margin="-7,0"/>
        </StackPanel>
          </Border>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
        <Grid x:Name="ProfilesHost"/>
      </Grid>

      <Grid x:Name="SettingsPanel" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Настройки" Style="{StaticResource PageHeading}"/>
          <TextBlock Text="Монитор, горячая клавиша и обновления." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="2,0,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="19">
              <StackPanel>
                <TextBlock Text="Оверлей" Style="{StaticResource SectionHeading}" Margin="0,0,0,16"/>
                <TextBlock Text="Монитор для прицела" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <ComboBox x:Name="MonitorBox" SelectionChanged="MonitorChanged" AutomationProperties.Name="Монитор для прицела"/>
                <TextBlock Text="Автоматический режим выбирает монитор активного окна." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
                <TextBlock Text="Клавиши показа и скрытия" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="ModifierBox" AutomationProperties.Name="Модификаторы горячей клавиши"/>
                  <ComboBox x:Name="KeyBox" Grid.Column="2" AutomationProperties.Name="Функциональная клавиша"/>
                  <Button Grid.Column="4" Content="Применить" Click="ApplyHotkeyClick"/>
                </Grid>
                <TextBlock x:Name="HotkeyFeedback" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,8"/>
                <CheckBox x:Name="TrayToggle" Content="Сворачивать в системный трей" Checked="TrayPreferenceChanged" Unchecked="TrayPreferenceChanged"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Panel}" Padding="19" Margin="0,0,0,12">
                <StackPanel x:Name="PreferencesHost"/>
              </Border>
              <Border Style="{StaticResource Panel}" Padding="19">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <TextBlock x:Name="SettingsVersion" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                  <TextBlock Text="Обновления Prism" Style="{StaticResource SectionHeading}"/>
                </DockPanel>
                <CheckBox x:Name="UpdatesToggle" Content="Проверять обновления автоматически" Checked="UpdatePreferenceChanged" Unchecked="UpdatePreferenceChanged"/>
                <TextBlock x:Name="UpdateFeedback" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,12" AutomationProperties.LiveSetting="Polite"/>
                <WrapPanel>
                  <Button x:Name="CheckUpdateButton" Content="Проверить" Click="CheckUpdateClick" Margin="0,0,6,4"/>
                  <Button x:Name="ReleaseButton" Content="GitHub ↗" Click="OpenReleaseClick" Margin="0,0,0,4"/>
                </WrapPanel>
              </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
      </Grid>
    </Grid>

    <DockPanel Grid.Row="2" Margin="102,0,23,0" LastChildFill="True">
      <Button x:Name="UpdateAvailable" DockPanel.Dock="Right" Visibility="Collapsed" Click="OpenReleaseClick" VerticalAlignment="Center"
              MinHeight="28" Margin="8,0,0,0" Tag="primary"/>
      <TextBlock x:Name="FooterVersion" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
      <TextBlock x:Name="Notice" Style="{StaticResource Caption}" Margin="0,0,14,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Grid>
</Window>
