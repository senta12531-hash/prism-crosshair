<Window x:Class="Prism.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Prism"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Prism Crosshair" Width="1232" Height="852" MinWidth="925" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Icon="/Assets/Prism.ico" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <chrome:WindowChrome.WindowChrome>
    <chrome:WindowChrome CaptionHeight="53" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </chrome:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="54"/>
      <RowDefinition Height="100"/>
      <RowDefinition/>
      <RowDefinition Height="52"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="#15151D">
      <DockPanel Margin="24,0,10,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
          <Border Width="29" Height="29" Background="{StaticResource AccentBrush}" CornerRadius="8">
            <Path Stroke="#17342B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M8,0 L16,8 8,16 0,8 Z M8,5 L8,11 M5,8 L11,8"/>
          </Border>
          <TextBlock Text="P R I S M" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="11,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="MinimizeClick" ToolTip="Свернуть" AutomationProperties.Name="Свернуть"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="MaximizeClick" ToolTip="Развернуть" AutomationProperties.Name="Развернуть"/>
          <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="CloseClick" ToolTip="Закрыть Prism" AutomationProperties.Name="Закрыть Prism"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="42,0,0,0"
                    chrome:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="EditorTab" Content="Редактор" Tag="selected" Click="EditorClick" MinWidth="104" MinHeight="32"/>
          <Button x:Name="SettingsTab" Content="Настройки" Click="SettingsClick" MinWidth="104" MinHeight="32" Margin="6,0,0,0"
                  Background="Transparent" BorderThickness="1"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="28,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Редактор прицела" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="34" Margin="0,-2,0,2"/>
        <TextBlock Text="Настройте прицел и включите его поверх игры." Foreground="{StaticResource MutedBrush}" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                Padding="10,0" Height="38" Margin="0,0,9,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource VioletBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="HeaderShortcut" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>
        <Button x:Name="OverlayButton" Tag="primary" Click="OverlayClick" MinHeight="42" Padding="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="OverlayButtonLabel" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="28,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"
        MinWidth="338"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="14"/><RowDefinition Height="150"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Panel}" Padding="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <DockPanel VerticalAlignment="Top" Height="32" Margin="4,0">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Фон" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SceneBox" Width="102" MinHeight="30" SelectionChanged="PreviewChanged" AutomationProperties.Name="Фон предпросмотра"/>
              </StackPanel>
              <TextBlock Text="Предпросмотр" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <local:PreviewSurface x:Name="Preview" IsHitTestVisible="False"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="#E6191925" CornerRadius="5" Padding="7,4" IsHitTestVisible="False">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewShapeLabel" FontSize="11" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <DockPanel Grid.Row="2" LastChildFill="False" VerticalAlignment="Bottom" Margin="4,0">
              <TextBlock x:Name="Coordinates" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Масштаб" Style="{StaticResource Caption}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <Button x:Name="ZoomOut" Content="−" Width="28" MinHeight="27" Padding="0" Click="ZoomOutClick" AutomationProperties.Name="Уменьшить масштаб"/>
                <TextBlock x:Name="ZoomLabel" Width="41" TextAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                <Button x:Name="ZoomIn" Content="+" Width="28" MinHeight="27" Padding="0" Click="ZoomInClick" AutomationProperties.Name="Увеличить масштаб"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14,11,14,12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="4,0">
              <Button DockPanel.Dock="Right" Content="+ Сохранить" Click="SavePresetClick" MinHeight="30" VerticalAlignment="Top" />
              <TextBlock Text="Пресеты" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
              <StackPanel x:Name="PresetCards" Orientation="Horizontal"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="1">
        <Grid>
          <ScrollViewer x:Name="EditorPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,15,18,14">
              <DockPanel Margin="0,0,0,11">
                <Button DockPanel.Dock="Right" Content="Сбросить" Click="ResetClick" MinHeight="29" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="Конфигурация" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="Форма" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
              <UniformGrid x:Name="ShapeButtons" Columns="5" Rows="1" Margin="-3,0,-3,0"/>
              <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,12"/>
              <TextBlock Text="Геометрия" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <UniformGrid x:Name="GeometrySliders" Columns="2" Margin="-7,0"/>
              <Grid Margin="0,1,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <CheckBox x:Name="DotToggle" Content="Точка" Click="DotClick"/>
                <CheckBox Grid.Column="2" x:Name="OutlineToggle" Content="Контур" Click="OutlineClick"/>
              </Grid>
              <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,12"/>
              <DockPanel Margin="0,0,0,7" LastChildFill="True">
                <TextBox x:Name="HexInput" DockPanel.Dock="Right" Width="89" MinHeight="29" MaxLength="7" VerticalAlignment="Center"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11" KeyDown="HexKeyDown" LostKeyboardFocus="HexLostFocus"
                         ToolTip="Введите HEX-цвет и нажмите Enter" AutomationProperties.Name="HEX-цвет"/>
                <TextBlock Text="Цвет" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <UniformGrid x:Name="Palette" Rows="1" Margin="-2,0"/>
              <StackPanel x:Name="ColorControls" Margin="-7,8,-7,0"/>
              <Expander x:Name="OffsetsExpander" Header="Смещение от центра" Foreground="{StaticResource TextBrush}" Margin="-3,8,0,0" Padding="3">
                <UniformGrid x:Name="OffsetSliders" Columns="2" Margin="-4,6,-7,0"/>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,15,18,14">
              <TextBlock Text="Настройки" Style="{StaticResource SectionHeading}" Margin="0,4,0,14"/>
              <TextBlock Text="Монитор для прицела" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <ComboBox x:Name="MonitorBox" SelectionChanged="MonitorChanged" AutomationProperties.Name="Монитор для прицела"/>
              <TextBlock Text="Автоматический режим выбирает монитор активного окна." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/>
              <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>
              <TextBlock Text="Клавиши показа и скрытия" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="ModifierBox" AutomationProperties.Name="Модификаторы горячей клавиши"/>
                <ComboBox x:Name="KeyBox" Grid.Column="2" AutomationProperties.Name="Функциональная клавиша"/>
                <Button Grid.Column="4" Content="Применить" Click="ApplyHotkeyClick"/>
              </Grid>
              <TextBlock x:Name="HotkeyFeedback" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite"/>
              <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14,0,8"/>
              <CheckBox x:Name="TrayToggle" Content="Сворачивать в системный трей" Click="TrayClick"/>
              <CheckBox x:Name="UpdatesToggle" Content="Проверять обновления автоматически" Click="UpdatesToggleClick"/>
              <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,14"/>
              <DockPanel Margin="0,0,0,7">
                <TextBlock x:Name="SettingsVersion" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock Text="Обновления Prism" FontWeight="SemiBold"/>
              </DockPanel>
              <TextBlock x:Name="UpdateFeedback" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,9" AutomationProperties.LiveSetting="Polite"/>
              <WrapPanel>
                <Button x:Name="CheckUpdateButton" Content="Проверить" Click="CheckUpdateClick" Margin="0,0,6,4"/>
                <Button x:Name="ReleaseButton" Content="GitHub ↗" Click="OpenReleaseClick" Margin="0,0,0,4"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="30,0" LastChildFill="True">
      <Button x:Name="UpdateAvailable" DockPanel.Dock="Right" Visibility="Collapsed" Click="OpenReleaseClick" VerticalAlignment="Center"
              MinHeight="28" Margin="8,0,0,0" Tag="primary"/>
      <TextBlock x:Name="FooterVersion" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="OverlayIndicator" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="FooterOverlayStatus" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="Notice" Style="{StaticResource Caption}" Margin="14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Grid>
</Window>
